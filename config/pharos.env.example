# Copy to config/pharos.env and fill in your deployment settings.
# This file is sourced by Bash; quote values that contain spaces.
# Do not commit credentials. Reference: docs/configuration.md.

# OpenAI-compatible Responses endpoint and API key.
# For subscription login, set CODEX_BACKEND=chatgpt and run setup-codex.sh login.
CODEX_API_BASE_URL=https://your-api-endpoint.example/v1
OPENAI_API_KEY=your-api-key-here

# Choose a model and reasoning effort supported by your backend.
PHAROS_CODEX_MODEL=gpt-6-astra
PHAROS_CODEX_EFFORT=max
# New project main/worker model; pharos new --model takes precedence.
#PHAROS_WORKER_MODEL=your-project-model

# Optional overrides.
#VERIFY_PORT=8091
#PHAROS_ROUND_HARD_TIMEOUT=14400
#PHAROS_MAX_ROUNDS=0
#PHAROS_VERIFY_MODEL=your-verifier-model
